# 공공데이터포털 (https://www.data.go.kr) 인증키 (Decoding 또는 Encoding 키)
# 활용 신청 권장 API:
# 1. 인천국제공항공사_항공기 운항 현황 상세 조회 (B551177/statusOfAllFltDeOdp)
# 2. 인천국제공항공사_여객편 운항현황(다국어) (B551177/StatusOfPassengerFlightsOdp)
# 3. 한국공항공사_실시간 항공기 운항정보 조회 (국내선 김포-제주 등)
DATA_GO_KR_SERVICE_KEY=

# Google Cloud Console YouTube Data API v3 키
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Google Cloud 프로젝트 ID (ADC / Cloud Run 서비스 계정 IAM으로 gemini-4-hydrogen 호출)
GOOGLE_CLOUD_PROJECT=YOUR_GCP_PROJECT_ID
